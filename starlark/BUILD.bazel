load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_fuzzing//fuzzing:cc_defs.bzl", "cc_fuzz_test")
load("//bzl:copts.bzl", "FFS_COPTS", "FFS_FUZZ_PLATFORMS")

cc_library(
    name = "starlark",
    hdrs = glob(["*.h"]),
    copts = FFS_COPTS,
    visibility = ["//visibility:public"],
)

[cc_test(
    name = src.removesuffix(".cc"),
    size = "small",
    srcs = [src],
    copts = FFS_COPTS,
    deps = [
        ":starlark",
        "@hastur//etest",
    ],
) for src in glob(
    include = ["*_test.cc"],
    exclude = ["*_fuzz_test.cc"],
)]

[cc_fuzz_test(
    name = src.removesuffix(".cc"),
    size = "small",
    testonly = True,
    srcs = [src],
    copts = FFS_COPTS,
    target_compatible_with = FFS_FUZZ_PLATFORMS,
    deps = [":starlark"],
) for src in glob(["*_fuzz_test.cc"])]
